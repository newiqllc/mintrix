# Ministra settings, created by ministra-install.sh with random passwords.
# After a change, run: ministra-update --version <running version>. Never share this file.

# Version to run; ministra-install.sh and ministra-update set this (Mintrix says which)
MINISTRA_VERSION=
MINISTRA_IMAGE=ghcr.io/newiqllc/ministra

# The Mintrix installation this Ministra belongs to: its address and its Inbound API Key
# (Mintrix > Settings > Ministra). Installs and updates are authorized by that Mintrix,
# and Ministra sends its change notifications there.
MINTRIX_SERVER_URL=
MINTRIX_API_KEY=
MINTRIX_TIMEOUT=5

# Ministra's REST API login, generated by ministra-install.sh: enter it in Mintrix
# (Settings > Ministra) together with this server's address
MINISTRA_API_LOGIN=
MINISTRA_API_PASSWORD=

# Database. The passwords are fixed when the database is first created:
# changing them here later does not change the existing database.
MYSQL_DATABASE=stalker_db
MYSQL_USER=stalker
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Port the portal listens on (set-top boxes open http://<server>:<port>/stalker_portal/c/).
# After a change, apply it in this folder with: docker compose up -d
MINISTRA_HTTP_PORT=80
# Where the port is reachable from:
#   (empty)       every address of this server: open to the network
#   127.0.0.1     this machine only: for your own proxy in front
MINISTRA_HTTP_BIND=

# off: the portal starts without running the database migrations
MINISTRA_MIGRATE=on
