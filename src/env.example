# Mintrix settings, created by install.sh with a new key and random passwords.
# After a change, run: mintrix-update --version <running version>. Never share this file.

# Version to run; install.sh and mintrix-update set this
MINTRIX_VERSION=
MINTRIX_IMAGE=ghcr.io/newiqllc/mintrix
MINTRIX_WEB_IMAGE=ghcr.io/newiqllc/mintrix-web

# Your license key, from your client area, and the domain the license is for (where
# users open Mintrix; not an IP address). install.sh asks for both and checks them with
# the license server; the license is tied to the domain on its first check. To move to
# another domain, reissue the license in your client area, then run mintrix-update.
MINTRIX_LICENSE_KEY=
MINTRIX_DOMAIN=

# Address users open Mintrix at (used in emails and links), set by install.sh from the domain
APP_URL=http://localhost:8000
# Encryption key for sessions, two-factor secrets and stored settings.
# Generated once by install.sh: never change or lose it.
APP_KEY=

# Database. The passwords are fixed when the database is first created:
# changing them here later does not change the existing database.
DB_DATABASE=mintrix
DB_USERNAME=mintrix
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Ports Mintrix listens on, for HTTP and HTTPS. After a change, apply it in this folder
# with: docker compose up -d
MINTRIX_HTTP_PORT=80
MINTRIX_HTTPS_PORT=443
# Where each port is reachable from:
#   (empty)       every address of this server, IPv4 and IPv6: open to the network
#   127.0.0.1     this machine only: for your own proxy in front, or to keep HTTP or
#                 HTTPS from being reached at all
#   203.0.113.10  only that one of this server's addresses
MINTRIX_HTTP_BIND=
MINTRIX_HTTPS_BIND=
# The HTTPS certificate is certs/mintrix.crt (with the intermediate chain) and
# certs/mintrix.key in this folder: a Cloudflare Origin Certificate for SSL/TLS mode
# Full (strict), or any other. Without one, or with one that is expired or does not
# match its key, Mintrix serves a self-signed certificate (enough for Cloudflare's mode
# Full) and logs why. After replacing it: docker compose restart nginx
# on: plain HTTP is redirected to HTTPS. Leave off behind Cloudflare: it does that itself.
MINTRIX_HTTPS_REDIRECT=off

# The proxy in front of Mintrix, so it sees each visitor's own IP address (sign-in
# limits, IP whitelist, logs) and whether they came over HTTPS:
#   cloudflare                  Cloudflare
#   10.0.0.5,192.168.1.0/24     your own proxy's addresses (it sends X-Forwarded-For)
#   (empty)                     no proxy: visitors connect directly
MINTRIX_TRUSTED_PROXIES=

# Outgoing email (password resets, notifications), from your mail provider
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Empty for STARTTLS on 587; "smtps" for port 465
MAIL_SCHEME=
MAIL_FROM_ADDRESS=mintrix@example.com
MAIL_FROM_NAME=Mintrix

# Comma-separated IP addresses admins may sign in from; empty allows all
IP_WHITELIST=

# Only for a second installation on the same machine (see README): a different
# name keeps its containers and database separate; it also needs another port
# COMPOSE_PROJECT_NAME=mintrix-test
